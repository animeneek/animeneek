{
  "name": "animeneek",
  "productName": "AnimeNeek",
  "version": "1.26.110105",
  "description": "AnimeNeek - anime browser and player",
  "author": "AnimeNeek <animeneek@example.com>",
  "homepage": "https://github.com/animeneek/animeneek",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.animeneek.app",
    "productName": "AnimeNeek",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "AnimeNeek <animeneek@example.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "animeneek",
        "repo": "animeneek"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "electron-updater": "^6.8.11"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
